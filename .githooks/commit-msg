#!/usr/bin/env bash
# Angular 規約に沿っているかを検査する。規約は CONTRIBUTING.md を参照。
# CI（.github/workflows/ci.yml）も PR の各コミットにこのスクリプトを掛ける。
set -u

msg_file="$1"

# コメント行を落とす。件名は 1 行目、2 行目は空行でなければならない。
# 空行を飛ばして探すと、件名を書き忘れた時に本文の 1 行目を件名と誤認する
body=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$body" | head -n 1)
second=$(printf '%s\n' "$body" | sed -n '2p')

# 空のメッセージは git 自身が中断する。ここで重ねて言わない
[ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ] && exit 0

# マージ・リバート・fixup/squash は git が形を決めるので素通しする
case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ * ) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
fail=0

err() {
  [ "$fail" -eq 0 ] && echo "commit-msg: コミットメッセージが規約に沿っていない" >&2
  fail=1
  echo "  - $1" >&2
}

if ! printf '%s' "$subject" | grep -qE "^($types)(\([a-z0-9._-]+\))?: .+"; then
  err "1行目は '<type>(<scope>): <件名>' の形にする（type: $types）"
fi

# UTF-8 の継続バイト（0x80-0xBF）を落とすと文字数が出る。
# ${#subject} も wc -m もロケール依存でバイト数を返すことがあり、日本語の件名が常に溢れる
len=$(printf '%s' "$subject" | tr -d '\200-\277' | wc -c | tr -d ' ')
if [ "$len" -gt 72 ]; then
  err "1行目が ${len} 文字。72 文字以内に収める"
fi

case "$subject" in
  *。) err "件名の末尾に句点を付けない" ;;
esac

if [ -n "$(printf '%s' "$second" | tr -d '[:space:]')" ]; then
  err "件名と本文の間に空行を入れる"
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "  実際の1行目: $subject" >&2
  echo "  規約: CONTRIBUTING.md" >&2
  exit 1
fi

exit 0
