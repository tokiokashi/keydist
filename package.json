{
  "name": "keydist",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22.20.0 || >=24.4.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/check-prerender-render.ts && node --experimental-strip-types --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/check-modulepreload.ts && node --experimental-strip-types scripts/write-workspace-fallback.ts",
    "check:sample": "node --experimental-strip-types scripts/check-sample-text.ts",
    "generate:reading-candidates": "node --experimental-strip-types scripts/generate-reading-candidates.ts",
    "generate:kana-fixtures": "node --experimental-strip-types scripts/generate-kana-fixtures.ts",
    "generate:analyzer-regression-fixture": "node --experimental-strip-types scripts/gen-analyzer-regression-fixture.ts",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" \"test/*.test.ts\"",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "budoux": "0.10.0",
    "lindera-wasm": "6.2.0",
    "motion": "^14.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.3.0",
    "react-resizable": "^4.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/router-cli": "^1.167.44",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "^3.0.260903-beta",
    "patch-package": "8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "imports": {
    "#input/*": "./src/input/*",
    "#trace/*": "./src/trace/*",
    "#interpretation/*": "./src/interpretation/*",
    "#engine/*": "./src/engine/*",
    "#analyzers/*": "./src/analyzers/*",
    "#hosts/*": "./src/hosts/*",
    "#editors/*": "./src/editors/*",
    "#tester/*": "./src/tester/*",
    "#ui/*": "./src/ui/*",
    "#platform/*": "./src/platform/*",
    "#app/*": "./src/app/*"
  }
}
