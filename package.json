{
  "name": "keydist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/write-legacy-analyzer-redirect.ts",
    "check:sample": "node --experimental-strip-types scripts/check-sample-text.ts",
    "generate:kana-fixtures": "node --experimental-strip-types scripts/generate-kana-fixtures.ts",
    "generate:analyzer-regression-fixture": "node --experimental-strip-types scripts/gen-analyzer-regression-fixture.ts",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" \"test/*.test.ts\"",
    "typecheck": "tsr generate && tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.57",
    "motion": "^13.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260311-beta",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  },
  "imports": {
    "#input/*": "./src/input/*",
    "#trace/*": "./src/trace/*",
    "#interpretation/*": "./src/interpretation/*",
    "#engine/*": "./src/engine/*",
    "#analyzers/*": "./src/analyzers/*",
    "#hosts/*": "./src/hosts/*",
    "#editors/*": "./src/editors/*",
    "#tester/*": "./src/tester/*",
    "#ui/*": "./src/ui/*",
    "#platform/*": "./src/platform/*",
    "#app/*": "./src/app/*",
    "#legacy/*": "./src/legacy/*"
  }
}
