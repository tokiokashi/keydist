{
  "name": "keydist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.legacy.config.ts",
    "check:sample": "node --experimental-strip-types scripts/check-sample-text.ts",
    "generate:kana-fixtures": "node --experimental-strip-types scripts/generate-kana-fixtures.ts",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsr generate && tsc --noEmit",
    "test:browser": "playwright test",
    "test:browser:legacy": "playwright test --config playwright.legacy.config.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.57",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260311-beta",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "@playwright/test": "^1.63.0"
  }
}
